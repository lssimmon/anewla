<% content_for :title, "Todos" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-semibold">Todos</h1>
  <%= link_to "New todo", new_todo_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-green-600 hover:bg-green-700" %>
</div>

<div class="mb-4 text-sm text-gray-600">
  <strong>Sort by:</strong>
  <%= link_to "Priority", todos_path(sort: :priority), class: "ml-2 text-blue-600 hover:underline" %>
  <%= link_to "Due date", todos_path(sort: :due_date), class: "ml-2 text-blue-600 hover:underline" %>
  <%= link_to "Newest", todos_path, class: "ml-2 text-blue-600 hover:underline" %>
</div>

<div id="todos" class="space-y-4">
  <% @todos.each do |todo| %>
    <%= render todo %>
  <% end %>
</div>
