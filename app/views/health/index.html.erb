<% content_for :title, "Health" %>

<div class="max-w-3xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-3xl font-semibold">Health</h1>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <% if @latest_weight.present? %>
      <p class="text-sm text-gray-500">Latest weight</p>
      <p class="mt-2 text-3xl font-semibold text-gray-900">
        <%= number_with_precision(@latest_weight.display_value("lb"), precision: 1) %> lb
      </p>
      <p class="mt-2 text-sm text-gray-500">
        Tracked on <%= @latest_weight.recorded_on.strftime("%B %-d, %Y") %>
      </p>
    <% else %>
      <p class="text-gray-600">No weight entries yet.</p>
    <% end %>

    <div class="mt-6">
      <%= link_to "Track Weight", weights_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700" %>
    </div>
  </div>
</div>
